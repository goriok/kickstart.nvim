{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "compress": true,
    "removeEmptyLines": true
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "repomix-output.xml",
      "__pycache__/**",
      "*.pyc",
      ".venv/**",
      "dist/**",
      ".git/**"
    ]
  }
}
